# Production (AlwaysData) environment template.
#
# AlwaysData's hosting plan for this account does NOT expose a way to set
# real process environment variables (confirmed: the account-level
# "Environment" page and the site config only expose PHP version + Custom
# php.ini — no env-var panel, no FPM env[] mechanism). So on this host,
# a real .env file at the project root IS the production configuration
# source — includes/env.php's load_env() reads it exactly like it does
# locally, and would still yield to a real process env var first if this
# host ever gains one later (see includes/env.php's load_env()/env()).
#
# Deploy steps:
#   1. Copy this file to the production server as:
#        /home/kwasulcs/www/.env.production.example   (reference only)
#   2. Create the REAL file next to it, named exactly:
#        /home/kwasulcs/www/.env
#      filled in with real production values (never commit this).
#   3. Confirm .htaccess is also deployed to /home/kwasulcs/www/.htaccess
#      — it's what blocks this file from being downloaded over HTTP.
#
# NEVER commit a real .env or .env.production file — only this
# .env.production.example (placeholders only) belongs in version control.
# .gitignore already excludes .env and .env.* except the *.example files.

# ── Database (AlwaysData → your account → Databases) ─────────────────────
DB_HOST=YOUR_ALWAYSDATA_DB_HOST
DB_NAME=YOUR_ALWAYSDATA_DB_NAME
DB_USER=YOUR_ALWAYSDATA_DB_USER
DB_PASS=YOUR_ALWAYSDATA_DB_PASSWORD

# ── AI providers (config.php's AI_PROVIDER constant picks which is used;
#    ANTHROPIC_API_KEY is only needed for the rollback path — safe to
#    leave blank if you never intend to flip AI_PROVIDER back) ───────────
ANTHROPIC_API_KEY=
# platform.openai.com → API keys — this is the one actually in use
OPENAI_API_KEY=YOUR_OPENAI_API_KEY

# ── YouTube Data API v3 ──────────────────────────────────────────────────
YOUTUBE_API_KEY=YOUR_YOUTUBE_API_KEY

# ── Google OAuth ──────────────────────────────────────────────────────────
# Must be registered as an Authorized redirect URI on this OAuth client
# byte-for-byte, or Google rejects the callback with redirect_uri_mismatch.
GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=YOUR_GOOGLE_CLIENT_SECRET
GOOGLE_REDIRECT_URI=https://kwasulcs.alwaysdata.net/google_oauth_callback.php

# ── Google reCAPTCHA v3 ──────────────────────────────────────────────────
RECAPTCHA_SITE_KEY=YOUR_RECAPTCHA_SITE_KEY
RECAPTCHA_SECRET_KEY=YOUR_RECAPTCHA_SECRET_KEY

# ── Gmail SMTP (App Password, not the account login password) ───────────
MAIL_USERNAME=YOUR_PRODUCTION_MAIL_USERNAME
MAIL_PASSWORD=YOUR_PRODUCTION_MAIL_PASSWORD
MAIL_FROM_EMAIL=YOUR_PRODUCTION_MAIL_FROM_EMAIL
# Optional public privacy contact. Falls back to MAIL_FROM_EMAIL when empty.
LCS_PRIVACY_EMAIL=
# Increment this value whenever a revised policy requires acknowledgement.
LCS_PRIVACY_POLICY_VERSION=2026-09

# Shared signing key for recipient-bound Telegram links.
LCS_LINK_SIGNING_KEY=
# Canonical HTTPS application root used in notification links.
LCS_BASE_URL=https://kwasulcs.alwaysdata.net

# ── Telegram Bot notifications (disabled by default) ──────────────────
# Do not enable until the integration has been approved, deployed and fully
# configured with real server-side secrets.
TELEGRAM_ENABLED=0
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=TrustyGee_Bot
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_WEBHOOK_URL=https://kwasulcs.alwaysdata.net/telegram_webhook.php
# Stage 6 pilot: exactly one project-owner LCS user ID. Keep TELEGRAM_ENABLED=0;
# an empty allowlist keeps Telegram linking and delivery fail-closed.
TELEGRAM_PILOT_USER_IDS=
TELEGRAM_MAX_MESSAGES_PER_SECOND=25
TELEGRAM_MAX_ATTEMPTS=5
TELEGRAM_WORKER_MAX_SECONDS=8
TELEGRAM_WORKER_MAX_JOBS=100
TELEGRAM_LINK_TOKEN_TTL_SECONDS=600
TELEGRAM_CONTACT_PHONE=
TELEGRAM_CONTACT_FIRST_NAME=
TELEGRAM_CONTACT_LAST_NAME=

# ── Browser Web Push / PWA ───────────────────────────────────────────────
# Generate a dedicated VAPID key pair; never commit the real private key.
# Keep disabled until the outbound provider is installed and verified.
WEB_PUSH_ENABLED=0
WEB_PUSH_VAPID_PUBLIC_KEY=
WEB_PUSH_VAPID_PRIVATE_KEY=
